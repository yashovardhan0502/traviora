# ==============================================================================
# Traviora - AI Travel Planning & Execution Engine
# Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      Windows (PowerShell): Copy-Item .env.example .env
#      Linux / macOS:        cp .env.example .env
# 2. Fill in your own API keys and connection URLs below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & Inference (Groq)
# ------------------------------------------------------------------------------
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for session checkpointing and agent memory.
# Supported: Render, Supabase, Neon, AWS RDS, or local PostgreSQL.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/traviora_db?sslmode=require

# ------------------------------------------------------------------------------
# 3. External Tool APIs (MCP & Live Data)
# ------------------------------------------------------------------------------
# Tavily AI Search (Real-time web research, hotel pricing & attractions)
# Get your API key at: https://tavily.com
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# OpenWeatherMap API (Current weather & 5-day forecasts)
# Get your API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AviationStack API (Live flight search, routes & schedule lookup)
# Get your API key at: https://aviationstack.com
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Default Departure Airport (IATA 3-letter code, e.g. DEL, JFK, LHR, SFO)
DEFAULT_ORIGIN_IATA=DEL

# ------------------------------------------------------------------------------
# 4. Observability & Tracing (LangSmith - Optional)
# ------------------------------------------------------------------------------
# Enable LangSmith tracing for LangChain / LangGraph agent execution
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_PROJECT=Traviora
